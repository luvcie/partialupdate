{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partialupdate",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  "workers_dev": true,
  //   "routes": [
  //     {
  //       "pattern": "v1.gotell.io",
  //       "custom_domain": true,
  //     },
  //   ],
  "vars": {
    // "MODEL_PROVIDER": "gemini-direct",
    // "GEMINI_MODEL": "gemini-3.5-flash",
    // Set with `wrangler secret put BETTER_AUTH_SECRET`.
    // Set OAuth credentials with:
    // `wrangler secret put GITHUB_CLIENT_ID`
    // `wrangler secret put GITHUB_CLIENT_SECRET`
    // `wrangler secret put GOOGLE_CLIENT_ID`
    // `wrangler secret put GOOGLE_CLIENT_SECRET`
    // "CLOUDFLARE_AI_GATEWAY_MODEL": "xai/grok-4.3",
    // "CLOUDFLARE_AI_GATEWAY_MODEL_SETTINGS": {
    //   "reasoning_effort": "high",
    // },
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css", "**/*.html", "**/*.md"],
      "fallthrough": true,
    },
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["PartialUpdate"],
      "tag": "v1",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "PartialUpdate",
        "name": "PARTIAL_UPDATE",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "partialupdate-auth",
      "database_id": "local-partialupdate-auth",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
}
