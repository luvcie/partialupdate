{
	"name": "partialupdate",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"dev:secure": "bash scripts/dev-secure.sh",
		"dev:tunnel": "bash scripts/dev-secure.sh --tunnel",
		"db:migrate:local": "wrangler d1 migrations apply partialupdate-auth --local",
		"db:migrate:remote": "wrangler d1 migrations apply partialupdate-auth --remote",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"typescript": "^5.5.2",
		"wrangler": "^4.95.0"
	},
	"dependencies": {
		"better-auth": "^1.6.14",
		"kysely": "^0.28.17"
	}
}
