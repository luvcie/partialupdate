{
	"name": "partialupdate",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy:alpha": "wrangler deploy --env alpha",
		"deploy:alpha:bootstrap": "wrangler deploy --env alpha --secrets-file .secrets.alpha",
		"deploy:production": "wrangler deploy --env production",
		"deploy:production:bootstrap": "wrangler deploy --env production --secrets-file .secrets.production",
		"dev": "wrangler dev --ip 0.0.0.0",
		"dev:alpha": "wrangler dev --env alpha",
		"dev:production": "wrangler dev --env production",
		"dev:secure": "bash scripts/dev-secure.sh",
		"dev:tunnel": "bash scripts/dev-secure.sh --tunnel",
		"db:migrate:alpha": "wrangler d1 migrations apply partialupdate-auth-alpha --env alpha --remote",
		"db:migrate:local": "wrangler d1 migrations apply partialupdate-auth-local --local",
		"db:migrate:production": "wrangler d1 migrations apply partialupdate-auth-production --env production --remote",
		"start": "wrangler dev --ip 0.0.0.0",
		"cf-typegen": "wrangler types",
		"cf-typegen:alpha": "wrangler types --env alpha",
		"cf-typegen:production": "wrangler types --env production"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"typescript": "^5.5.2",
		"wrangler": "^4.95.0"
	},
	"dependencies": {
		"better-auth": "^1.6.14",
		"kysely": "^0.28.17"
	}
}
